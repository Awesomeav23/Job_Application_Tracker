# Database — port 5435 avoids the 5432/5433/5434 instances already on this machine
DATABASE_URL="postgresql://jobtracker:localdev@localhost:5435/jobtracker?schema=public"

# Auth (M5)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="24h"

# Development owner until M5 replaces it with the authenticated user (M4)
DEV_USER_ID=""

# AI provider (M8): MOCK | BEDROCK
AI_PROVIDER="MOCK"
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID=""

# Storage: LOCAL | S3
STORAGE_PROVIDER="LOCAL"
LOCAL_UPLOAD_DIR="./uploads"
S3_BUCKET=""

PORT=4001
NODE_ENV="development"
